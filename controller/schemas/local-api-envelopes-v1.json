        "sha256": {
          "type": "string"
        },
        "warnings": {
          "type": "array"
        }
      },
      "required": [
        "document",
        "revision",
        "sha256",
        "warnings"
      ],
      "additionalProperties": true
    },
    "Result_configuration.validate": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "array"
        },
        "warnings": {
          "type": "array"
        }
      },
      "required": [
        "errors",
        "warnings"
      ],
      "additionalProperties": true
    },
    "Result_configuration.review": {
      "type": "object",
      "properties": {
        "contentHash": {
          "type": "string"
        },
        "reviewToken": {
          "type": "string"
        },
        "expiresInSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "actions": {
          "type": "array"
        }
      },
      "required": [
        "contentHash",
        "reviewToken",
        "expiresInSeconds",
        "actions"
      ],
      "additionalProperties": true
    },
    "Result_configuration.apply": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "configurationApplied": {
          "type": "boolean"
        },
        "deviceSynchronized": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array"
        },
        "operationId": {
          "type": "string"
        },
        "deduplicated": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "configurationApplied",
        "deviceSynchronized",
        "warnings",
        "operationId"
      ],
      "additionalProperties": true
    },
    "Result_configuration.history": {
      "type": "object",
      "properties": {
        "revisions": {
          "type": "array"
        },
        "nextCursor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "revisions",
        "nextCursor"
      ],
      "additionalProperties": true
    },
    "Result_asset.beginImport": {
      "type": "object",
      "properties": {
        "uploadId": {
          "type": "string"
        },
