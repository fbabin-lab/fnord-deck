{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stream Deck Linux local API 1.0 envelopes and result shapes",
  "description": "Transport framing and parameter schemas are documented separately. Result schemas require stable top-level fields and allow additive fields; nested configuration and domain records use their documented contracts. Select a $defs Result_METHOD to validate a method result.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/SuccessResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    },
    {
      "$ref": "#/$defs/EventNotification"
    }
  ],
  "$defs": {
    "Request": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "additionalProperties": true
    },
    "SuccessResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "messageKey": {
                  "type": "string"
                },
                "details": {}
              },
              "required": [
                "code",
                "messageKey",
                "details"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "code",
            "message",
            "data"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "RuntimeEvent": {
      "type": "object",
      "properties": {
        "runtimeEpoch": {
          "type": "string"
        },
        "eventSequence": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "runtimeEpoch",
        "eventSequence",
        "revision",
        "type",
        "payload"
      ],
      "additionalProperties": true
    },
    "EventNotification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "runtime.event"
        },
        "params": {
          "$ref": "#/$defs/RuntimeEvent"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "Result_system.hello": {
      "type": "object",
      "properties": {
        "apiMajor": {
          "const": 1
        },
        "apiMinor": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeVersion": {
          "type": "string"
        },
        "maxFrameBytes": {
          "type": "integer",
          "minimum": 0
        },
        "capabilities": {
          "type": "object"
        }
      },
      "required": [
        "apiMajor",
        "apiMinor",
        "runtimeVersion",
        "maxFrameBytes",
        "capabilities"
      ],
      "additionalProperties": true
    },
    "Result_system.snapshot": {
      "type": "object",
      "properties": {
        "runtimeVersion": {
          "type": "string"
        },
        "runtimeEpoch": {
          "type": "string"
        },
        "eventSequence": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "configurationId": {
          "type": "string"
        },
        "currentPageId": {
          "type": "string"
        },
        "pageGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "paused": {
          "type": "boolean"
        },
        "device": {
          "type": "object"
        },
        "simulator": {
          "type": "boolean"
        },
        "executionEnabled": {
          "type": "boolean"
        },
        "plugins": {
          "type": "object"
        },
        "lastError": {},
        "recovery": {
          "type": [
            "string",
            "null"
          ]
        },
        "executionRecovery": {
          "type": [
            "string",
            "null"
          ]
        },
        "recentExecutions": {
          "type": "array"
        }
      },
      "required": [
        "runtimeVersion",
        "runtimeEpoch",
        "eventSequence",
        "revision",
        "configurationId",
        "currentPageId",
        "pageGeneration",
        "paused",
        "device",
        "simulator",
        "executionEnabled",
        "plugins",
        "lastError",
        "recovery",
        "executionRecovery",
        "recentExecutions"
      ],
      "additionalProperties": true
    },
    "Result_system.diagnostics": {
      "type": "object",
      "properties": {
        "runtimeVersion": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "dependencies": {
          "type": "object"
        },
        "font": {
          "type": "string"
        },
        "hidBackend": {
          "type": "string"
        },
        "hidLibrary": {
          "type": [
            "string",
            "null"
          ]
        },
        "codecs": {
          "type": "object"
        },
        "graphicalSessionAvailable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hardwareVerification": {
          "type": "string"
        },
        "pluginsSupported": {
          "type": "boolean"
        }
      },
      "required": [
        "runtimeVersion",
        "python",
        "platform",
        "dependencies",
        "font",
        "hidBackend",
        "hidLibrary",
        "codecs",
        "graphicalSessionAvailable",
        "hardwareVerification",
        "pluginsSupported"
      ],
      "additionalProperties": true
    },
    "Result_events.subscribe": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string"
        },
        "runtimeEpoch": {
          "type": "string"
        },
        "eventSequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "subscriptionId",
        "runtimeEpoch",
        "eventSequence"
      ],
      "additionalProperties": true
    },
    "Result_configuration.get": {
      "type": "object",
      "properties": {
        "document": {
          "type": "object"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
